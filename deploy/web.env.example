# Standalone Nginx frontend; copy this file to deploy/.env on the frontend host.
# Use the backend's private address. The backend's MUI_PUBLIC_URL is still the
# public HTTPS frontend URL, and MUI_TRUSTED_PROXIES must include this host's IP.
MUI_BACKEND_URL=http://10.0.0.10:8087
# Existing outer Nginx handles HTTPS and proxies to this loopback port.
MUI_BIND=127.0.0.1:8086
MUI_PROXY_SUBNET=172.30.17.0/24

# Docker's DNS resolver. Backend URLs must contain only scheme + host[:port],
# without a trailing slash or path.
MUI_DNS_RESOLVER=127.0.0.11

# Source IP of the outer Nginx as seen by this container. For host-OS Nginx
# on Linux this is the Docker bridge gateway; change with MUI_PROXY_SUBNET.
MUI_EDGE_PROXY_CIDR=172.30.17.1/32
