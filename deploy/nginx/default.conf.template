# Trust forwarded protocol only from the configured outer Nginx.
geo $realip_remote_addr $mui_edge_proxy {
    default 0;
    ${MUI_EDGE_PROXY_CIDR} 1;
}
map "$mui_edge_proxy:$http_x_forwarded_proto" $mui_forwarded_proto {
    default $scheme;
    "1:https" https;
    "1:http" http;
}

server {
    listen 8086;
    listen [::]:8086;
    server_name _;
    root /usr/share/nginx/html;

    # Resolve the backend again after a container replacement. Only MUI_*
    # placeholders are substituted; Nginx request variables stay intact.
    resolver ${MUI_DNS_RESOLVER} valid=10s;
    resolver_timeout 5s;
    set $mui_backend "${MUI_BACKEND_URL}";
    set_real_ip_from ${MUI_EDGE_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    include /etc/nginx/mui/routes.conf;
}
