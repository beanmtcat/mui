# Standalone Nginx server for the public status page (mui-status).
# Only serves status-web/dist static files and proxies /api/public/* + /healthz
# to Go's dedicated MUI_STATUS_LISTEN port. Never proxies /api/, /agent/,
# /download/, or /s/.
geo $realip_remote_addr $mui_edge_proxy {
    default 0;
    ${MUI_EDGE_PROXY_CIDR} 1;
}
map "$mui_edge_proxy:$http_x_forwarded_proto" $mui_forwarded_proto {
    default $scheme;
    "1:https" https;
    "1:http" http;
}
map $mui_forwarded_proto $mui_hsts {
    default "";
    https "max-age=31536000";
}

server {
    listen 8089;
    listen [::]:8089;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    client_max_body_size 64k;

    resolver ${MUI_DNS_RESOLVER} valid=10s;
    resolver_timeout 5s;
    set $mui_status_backend "${MUI_STATUS_BACKEND_URL}";
    set_real_ip_from ${MUI_EDGE_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    add_header X-Robots-Tag noindex always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; script-src 'self'; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security $mui_hsts always;

    proxy_hide_header X-Content-Type-Options;
    proxy_hide_header Referrer-Policy;
    proxy_hide_header X-Frame-Options;
    proxy_hide_header X-Robots-Tag;
    proxy_hide_header Content-Security-Policy;
    proxy_hide_header Strict-Transport-Security;

    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-Proto $mui_forwarded_proto;
    proxy_connect_timeout 10s;
    proxy_send_timeout 30s;
    proxy_read_timeout 30s;
    proxy_buffering off;
    proxy_ssl_server_name on;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;

    location = /nginx-health {
        access_log off;
        return 200 "ok\n";
    }

    location = /healthz {
        access_log off;
        proxy_pass $mui_status_backend$request_uri;
    }

    location ^~ /api/public/ {
        proxy_pass $mui_status_backend$request_uri;
    }

    location ~ ^/(api|agent|download|s)(/|$) {
        access_log off;
        return 404;
    }

    location ^~ /assets/ {
        try_files $uri =404;
        expires 1y;
    }

    location ~ /\. {
        return 404;
    }

    location = /index.html {
        try_files $uri =404;
        expires -1;
    }

    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
    }
}
