# 复制为 deploy/publish.env。本文件按 Bash 配置读取；含空格或特殊字符的值请加引号。
# SSH 配置别名，或 user@host；使用 SSH 密钥/ssh-agent，首次请先 ssh 确认主机指纹。
SSH_HOST=deploy@your-server
SSH_PORT=22
SSH_KEY="" # 可选，如 /Users/you/.ssh/id_ed25519；空值使用 SSH 默认配置

# 远程发布根目录，必须填写远程绝对路径，例如 /root/docker/mui。
# 不使用 ~ 或 $HOME，它们会在本机读取配置时展开。
# SSH 用户需有写权限及 Docker 权限。
REMOTE_DIR=/opt/mui
# 对已有 Compose 部署请填写原项目名，避免改变网络/镜像的项目归属。
COMPOSE_PROJECT=mui
HEALTH_TIMEOUT=120

# 同机前后端：compose.yaml（默认）
# 仅前端独立主机：compose.web.yaml，并传 --service frontend
# 独立后端需发布内网端口："compose.yaml compose.backend.yaml"，并传 --service backend
COMPOSE_FILES="compose.yaml"

# --with-agent 自动用本机 deploy/.secrets/release.key 签名，私钥不会上传。
# 自定义私钥路径时填写远程发布所用构建机上的绝对路径：
# MUI_RELEASE_KEY=/path/on/build-machine/release.key
