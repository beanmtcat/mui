# Public HTTPS address of the panel (used in agent install commands and subscription links).
MUI_PUBLIC_URL=https://mui.example.com
# Existing PostgreSQL, reachable FROM the backend container. For a database on
# the Docker host use host.docker.internal; otherwise use its private IP/DNS.
# PostgreSQL must listen on a reachable interface and permit this client in pg_hba.conf.
MUI_DB_HOST=host.docker.internal
MUI_DB_PORT=5432
MUI_DB_SSLMODE=require
MUI_DB_PASSWORD=replace-with-long-random-secret
MUI_DB_NAME=mui
MUI_DB_USER=mui
MUI_SECRET=replace-with-independent-long-random-secret
MUI_ADMIN_PASSWORD=replace-with-strong-admin-password

# Inner Nginx HTTP listener. The existing outer Nginx handles HTTPS and
# proxies to this loopback port. No host ports 80/443 or certificates required.
MUI_BIND=127.0.0.1:8080

# Private network between the frontend and backend. Change if it overlaps an
# existing network. Go trusts this network by default; PostgreSQL is managed externally.
MUI_PROXY_SUBNET=172.30.17.0/24

# Go backend origin used by Nginx (no trailing slash or path). On separate
# hosts, set this to the backend's private IP and published port.
MUI_BACKEND_URL=http://mui-service:8080
MUI_DNS_RESOLVER=127.0.0.11

# CIDRs of reverse proxies whose X-Forwarded-For is trusted (rate limiting is per client IP).
# Empty uses MUI_PROXY_SUBNET in Compose. For a separate frontend host, set its
# exact source IP/CIDR here and publish the backend with compose.backend.yaml.
MUI_TRUSTED_PROXIES=
MUI_BACKEND_BIND=127.0.0.1:8081

# Actual outer Nginx source as seen by the frontend container. For host-OS
# Nginx on Linux this is the Docker bridge gateway; change with the subnet.
# If the outer Nginx is remote or containerized, use its actual source IP/CIDR.
# This is separate from Go's MUI_TRUSTED_PROXIES.
MUI_EDGE_PROXY_CIDR=172.30.17.1/32

# Days of raw traffic samples to keep (totals are kept forever). 0 keeps everything.
MUI_TRAFFIC_RETENTION_DAYS=90

# Set to 1 for one start to reset the admin password to MUI_ADMIN_PASSWORD and clear TOTP.
# MUI_ADMIN_RESET=1

# Public half of the release signing key (go run ./cmd/release-sign keygen release.key).
# When set, agents pin it at install time and only accept upgrades whose manifest
# was signed with the private half; the panel refuses to offer unsigned builds.
# MUI_RELEASE_PUBLIC_KEY=
