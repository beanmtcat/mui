# Public HTTPS address of the panel (used in agent install commands and subscription links).
MUI_PUBLIC_URL=https://mui.example.com
MUI_DB_PASSWORD=replace-with-long-random-secret
MUI_DB_NAME=mui
MUI_DB_USER=mui
MUI_SECRET=replace-with-independent-long-random-secret
MUI_ADMIN_PASSWORD=replace-with-strong-admin-password

# Host address:port the panel is published on. Keep it on loopback behind your own
# reverse proxy; use 0.0.0.0:443 only together with MUI_TLS_CERT / MUI_TLS_KEY.
MUI_BIND=127.0.0.1:8080

# CIDRs of reverse proxies whose X-Forwarded-For is trusted (rate limiting is per client IP).
# With a proxy on the Docker host this is the Docker bridge network, e.g. 172.16.0.0/12.
MUI_TRUSTED_PROXIES=

# Optional: let the panel terminate TLS itself. Put the files in deploy/tls/ (or MUI_TLS_DIR).
# MUI_TLS_CERT=/app/tls/fullchain.pem
# MUI_TLS_KEY=/app/tls/privkey.pem

# Days of raw traffic samples to keep (totals are kept forever). 0 keeps everything.
MUI_TRAFFIC_RETENTION_DAYS=90

# Set to 1 for one start to reset the admin password to MUI_ADMIN_PASSWORD and clear TOTP.
# MUI_ADMIN_RESET=1

# Public half of the release signing key (go run ./cmd/release-sign keygen release.key).
# When set, agents pin it at install time and only accept upgrades whose manifest
# was signed with the private half; the panel refuses to offer unsigned builds.
# MUI_RELEASE_PUBLIC_KEY=
