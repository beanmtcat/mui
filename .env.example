# Copy to .env and replace all three secrets before first start.
# Keep MUI_SECRET unchanged after creating data; it encrypts stored credentials.
MUI_SECRET=replace-with-a-long-random-secret-at-least-32-characters
MUI_ADMIN_PASSWORD=replace-with-a-password-of-at-least-12-characters
MUI_DB_PASSWORD=replace-with-a-long-random-db-password
MUI_DB_HOST=127.0.0.1
MUI_DB_PORT=55432
MUI_DB_NAME=mui
MUI_DB_USER=mui
MUI_DB_SSLMODE=disable
# Comma-separated public URLs; first is the default.
MUI_PUBLIC_URL=http://127.0.0.1:5173
MUI_LISTEN=127.0.0.1:8080
